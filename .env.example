# Cơ sở dữ liệu (docker compose up -d db, hoặc npm run db:local)
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/inbox"
# Để trống thì test tự khởi động một PostgreSQL nhúng riêng.
TEST_DATABASE_URL=""

# Email Google của chủ trung tâm; tự được tạo với vai trò chủ ở lần đăng nhập đầu.
OWNER_EMAIL=""

# Ứng dụng OAuth của Google (Google Cloud Console → Credentials → OAuth client ID, loại Web).
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Chuỗi ngẫu nhiên, ví dụ: npx auth secret
AUTH_SECRET=""

# Khoá mã hoá thông tin truy cập kênh: 32 byte dạng base64.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""

# Bật kênh giả lập và trang /dev/simulator (chỉ dev/test; PHẢI tắt khi triển khai thật).
ENABLE_SIMULATOR="true"
SIMULATOR_SECRET="dev-simulator-secret"

# Thư mục lưu ảnh khách gửi và ảnh đại diện.
UPLOAD_DIR="./uploads"

# Địa chỉ công khai của website (dùng cho URL quay về khi kết nối kênh).
APP_URL="http://localhost:3000"

# Meta (Facebook, Instagram)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
# Bật sau khi Meta duyệt quyền "human agent": trả lời được trong 7 ngày thay vì 24 giờ.
META_HUMAN_AGENT="false"
# Phiên bản Graph API của Meta.
META_GRAPH_VERSION="v23.0"

# Zalo Official Account
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_SECRET_KEY=""
# Thời hạn trả lời Zalo (giờ). Mặc định 48; cần xác nhận với Zalo khi OA được duyệt.
ZALO_REPLY_WINDOW_HOURS="48"

# Chỉ dùng cho docker-compose.prod.yml
POSTGRES_PASSWORD=""
