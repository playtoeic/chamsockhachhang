// Schema theo specs/001-unified-inbox-crm/data-model.md.
// Mọi thời điểm lưu ở UTC; ngày và khung giờ của lịch hiểu theo Asia/Ho_Chi_Minh.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  staff
}

enum Platform {
  facebook
  instagram
  zalo
  simulator
}

enum ConnectionStatus {
  connected
  disconnected
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageKind {
  text
  image
  unsupported
}

enum MessageStatus {
  received
  sending
  sent
  failed
}

enum StudentStatus {
  considering
  trialed
  enrolled
  dropped
}

enum StatusSource {
  auto
  manual
}

enum Slot {
  S1
  S2
  S3
  S4
}

enum Step {
  trial_scheduled
  class_scheduled
  entry_test
  tuition_paid
  commitment_signed
}

// ---------- Người dùng và Auth.js ----------

model User {
  id            String    @id @default(cuid())
  /// duy nhất, lưu chữ thường
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(staff)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  accounts             Account[]
  sessions             Session[]
  assignedConversations Conversation[] @relation("Assignee")
  sentMessages         Message[]      @relation("SentBy")
  stepsDone            StepProgress[]
  qaUpdated            QaEntry[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Kênh và tin nhắn ----------

model ChannelConnection {
  id                String           @id @default(cuid())
  platform          Platform
  externalAccountId String
  displayName       String
  status            ConnectionStatus @default(connected)
  /// mã hoá khi lưu; không bao giờ trả về trình duyệt; xoá khi ngắt kết nối
  credentials       String?
  lastError         String?
  connectedAt       DateTime         @default(now())

  conversations Conversation[]

  @@unique([platform, externalAccountId])
}

model Conversation {
  id                   String    @id @default(cuid())
  channelConnectionId  String
  externalThreadId     String
  customerName         String
  /// bản sao ảnh đại diện trong UPLOAD_DIR
  customerAvatarPath   String?
  studentId            String?
  assigneeUserId       String?
  unread               Boolean   @default(false)
  lastMessageAt        DateTime  @default(now())
  /// thời điểm tin cuối của khách
  lastInboundAt        DateTime?
  replyWindowExpiresAt DateTime?
  createdAt            DateTime  @default(now())

  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  student           Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assignee          User?             @relation("Assignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  messages          Message[]

  @@unique([channelConnectionId, externalThreadId])
  @@index([lastMessageAt])
  @@index([studentId])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  kind              MessageKind
  /// bắt buộc khi kind = text
  body              String?
  /// bắt buộc khi kind = image
  mediaPath         String?
  /// tên loại nội dung khi kind = unsupported
  unsupportedType   String?
  /// duy nhất theo (conversationId, externalMessageId) khi có giá trị
  externalMessageId String?
  /// bắt buộc khi tin outbound gửi từ website; trống khi tin outbound gửi từ ứng dụng gốc
  sentByUserId      String?
  status            MessageStatus
  /// bắt buộc khi status = failed
  failureReason     String?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("SentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
}

// ---------- Học sinh và lịch ----------

model Student {
  id             String        @id @default(cuid())
  /// bắt buộc, không trống
  name           String
  source         String?
  avatarPath     String?
  autoCreated    Boolean       @default(false)
  note           String?
  status         StudentStatus @default(considering)
  statusSource   StatusSource  @default(manual)
  lastActivityAt DateTime      @default(now())
  createdAt      DateTime      @default(now())

  conversations Conversation[]
  trialBooking  TrialBooking?
  classSlots    ClassAssignment[]
  steps         StepProgress[]

  @@index([lastActivityAt])
  @@index([status])
}

model TrialBooking {
  /// duy nhất — mỗi học sinh tối đa một buổi trên mọi tuần
  studentId    String    @id
  /// phải là thứ 2–thứ 7 (ngày theo giờ Việt Nam, lưu ở 00:00 UTC)
  date         DateTime  @db.Date
  slot         Slot
  autoMarkedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([date])
}

model ClassAssignment {
  studentId String
  /// 1–6 (thứ 2–thứ 7)
  weekday   Int
  slot      Slot

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, weekday, slot])
}

model StepProgress {
  studentId    String
  step         Step
  done         Boolean
  /// trống khi được tick tự động
  doneByUserId String?
  doneAt       DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  doneBy  User?   @relation(fields: [doneByUserId], references: [id], onDelete: SetNull)

  @@id([studentId, step])
}

model QaEntry {
  id              String   @id @default(cuid())
  question        String
  answer          String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}
