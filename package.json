    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
